{
  "meta": {
    "title": "克制与搭配",
    "description": "英雄克制/被克制/配合关系。relation: counter=克制target, countered_by=被target克制, synergy=与target配合。reason 供 LLM 解释；basis 为机制依据类别，可回溯到 rules/inference 层。",
    "source_note": "克制/配合逻辑为稳定机制常识(source=stable)，具体版本胜率未纳入。",
    "basis_legend": {
      "damage-type": "伤害类型错配 → rules.damage-types / inference.counter-essence-damage-type",
      "resource": "法力/资源克制(烧蓝) → 资源依赖型英雄的软肋",
      "control": "控制/先手/沉默 → rules.first-move-value",
      "vision": "视野/真视(反隐/反闪避) → rules.vision-information",
      "mobility": "机动(切入/风筝/位移) → 站位与先手",
      "aoe": "AOE(清幻象/召唤/聚怪) → 多目标克制",
      "sustain": "续航/复活/保命(治疗/薄葬) → rules.positioning-economy(容错)",
      "physical": "物理对抗(护甲/减甲/近战克制) → rules.armor-formula / inference.minus-armor-linear-scaling"
    }
  },
